# Server environment variables
# Copy this file to .env and fill in the values before starting.

# Port the Express server listens on.
PORT=5000

# Allowed client origin(s) for CORS.
# In development this defaults to http://localhost:5173 when unset.
# In production (NODE_ENV=production) this MUST be set or the server will
# refuse to start. Accepts a comma-separated list of origins.
CLIENT_ORIGIN=http://localhost:5173

# Node environment. Set to "production" in production deployments.
NODE_ENV=development
