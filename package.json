  "license": "ISC",
  "bugs": {
    "url": "https://github.com/vasus609/Competitive-Programming-Dashboard/issues"
  },
  "homepage": "https://github.com/vasus609/Competitive-Programming-Dashboard#readme",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}